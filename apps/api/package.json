{
  "name": "@devdocs/api",
  "version": "0.1.0",
  "private": true,
  "exports": {
    "./trpc": {
      "types": "./src/trpc/router.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch src/hono-server.ts",
    "build": "tsc --noEmit && node build.mjs",
    "start": "node dist/hono-server.cjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:smoke": "node scripts/smoke-build.mjs",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "db:migrate": "node scripts/migrate-configured.mjs",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "^0.32.0",
    "@anthropic-ai/sdk": "^0.27.3",
    "@clerk/express": "^2.1.43",
    "@devdocs/shared": "workspace:*",
    "@hono/node-server": "^2.0.10",
    "@hono/zod-validator": "^0.9.0",
    "@sentry/node": "^10.66.0",
    "@sentry/profiling-node": "^10.66.0",
    "@trpc/server": "^11.18.0",
    "@upstash/redis": "^1.34.0",
    "drizzle-orm": "^0.45.2",
    "dotenv": "^17.4.2",
    "hono": "^4.13.5",
    "openai": "^4.67.3",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.4",
    "resend": "^6.17.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@vitest/ui": "^4.1.10",
    "drizzle-kit": "^0.24.0",
    "esbuild": "^0.28.2",
    "kysely": "0.28.17",
    "tsx": "^4.16.0",
    "typescript": "^5.5.4",
    "vitest": "^4.1.10"
  }
}
