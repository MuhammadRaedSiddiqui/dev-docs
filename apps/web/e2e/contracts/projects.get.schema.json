{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "tRPC projects.get response",
  "description": "Batched or single tRPC response wrapping one project including interviewData. Validated only when the URL matches projects.get.",
  "oneOf": [
    {
      "type": "object",
      "required": ["result"],
      "properties": {
        "result": {
          "type": "object",
          "required": ["data"],
          "properties": { "data": { "$ref": "#/definitions/projectDetail" } }
        }
      }
    },
    {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["result"],
        "properties": {
          "result": {
            "type": "object",
            "required": ["data"],
            "properties": { "data": { "$ref": "#/definitions/projectDetail" } }
          }
        }
      }
    }
  ],
  "definitions": {
    "projectDetail": {
      "type": "object",
      "required": ["id", "name", "type"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "name": { "type": "string", "minLength": 1 },
        "type": {
          "type": "string",
          "enum": ["saas", "api", "internal_tool", "mobile", "landing_page", "other"]
        },
        "status": { "type": "string" },
        "interviewData": { "type": ["object", "null"] }
      }
    }
  }
}
