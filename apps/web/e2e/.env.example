# apps/web/e2e/.env.example — copy to apps/web/e2e/.env and fill in. NEVER commit .env.
# Base URL of the app under test (must match apps/web `dev` script port).
BASE_URL=http://localhost:3000

# Parallel workers (omit for default; set WORKERS=1 in CI for stability).
WORKERS=

# ── Human-in-the-loop (CI) ──────────────────────────────────────────
# Slack-compatible webhook URL the framework POSTs to on HITL pauses.
HITL_WEBHOOK_URL=
# Shared secret guarding POST /resume/:token (resume endpoint auth).
HITL_RESUME_SECRET=
# Port for the HITL resume server (operator access only — VPN/tunnel, never public).
HITL_RESUME_PORT=9234

# ── Optional AI enrichment ──────────────────────────────────────────
# Off by default. When "true", unclassified/low-confidence triage calls Claude.
ENABLE_AI_TRIAGE=
# Required for ENABLE_AI_TRIAGE=true and for `test:ai` scaffolding.
ANTHROPIC_API_KEY=

# ── Test data ───────────────────────────────────────────────────────
# Seeded project used by specs that need an existing project id.
E2E_PROJECT_ID=
