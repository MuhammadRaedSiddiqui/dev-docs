# .env.local — copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.

# ── Express API ────────────────────────────────────────────────────────────────
# URL of the Express API server (apps/api).
# In development this is localhost:4000.
# In production it should be your Railway/Fly.io API subdomain.
NEXT_PUBLIC_API_URL=http://localhost:4000

# ── Authentication (Clerk) ─────────────────────────────────────────────────────
# Get your keys from https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Customize auth URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# REQUIRED: pin Clerk's CDN scripts to exact versions. Unpinned aliases
# (@clerk/clerk-js@6, @clerk/ui@1) 307-redirect, which browsers refuse on CORS
# preflights — breaking sign-in with "Failed to load Clerk JS".
NEXT_PUBLIC_CLERK_JS_VERSION=6.25.5
NEXT_PUBLIC_CLERK_UI_VERSION=1.25.5

# ── Analytics (PostHog) ────────────────────────────────────────────────────────
# Optional: Get from https://posthog.com
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ── Error Monitoring (Sentry) ──────────────────────────────────────────────────
# Optional: Get from https://sentry.io
NEXT_PUBLIC_SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx

# ── App URL ────────────────────────────────────────────────────────────────────
# Used for OAuth redirects and Open Graph metadata.
NEXT_PUBLIC_APP_URL=http://localhost:3000
