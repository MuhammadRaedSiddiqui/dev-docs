{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs":    ["$TURBO_DEFAULT$", ".env.local"],
      "outputs":   [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache":      false,
      "persistent": true
    },
    "start": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "cache": false
    },
    "clean": {
      "cache": false
    }
  }
}
